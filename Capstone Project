import re
import sqlite3
import urllib.parse
import pandas as pd
import requests
from bs4 import BeautifulSoup

BASE_URL = "http://books.toscrape.com/"
FIXED_GBP_TO_INR = 105.50
DB_PATH = "zepto_catalog.db"

RATING_MAP = {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5
}

def scrape_catalog(min_books=60):
    scraped_data = []
    page_url = BASE_URL + "catalogue/page-1.html"
    
    while page_url and len(scraped_data) < min_books:
        response = requests.get(page_url, timeout=10)
        if response.status_code != 200:
            break
            
        soup = BeautifulSoup(response.content, "html.parser")
        articles = soup.find_all("article", class_="product_pod")
        
        for article in articles:
            title = article.h3.a["title"]
            price_text = article.find("p", class_="price_color").text
            rating_class = article.find("p", class_="star-rating")["class"]
            rating_str = [c for c in rating_class if c.lower() != "star-rating"][0].lower()
            availability_text = article.find("p", class_="instock availability").text.strip()
            
            # Fetch book detail page for category extraction
            detail_rel_link = article.h3.a["href"]
            if not detail_rel_link.startswith("catalogue/"):
                detail_rel_link = "catalogue/" + detail_rel_link
            detail_url = urllib.parse.urljoin(BASE_URL, detail_rel_link)
            
            cat_resp = requests.get(detail_url, timeout=10)
            category_name = "Default"
            if cat_resp.status_code == 200:
                cat_soup = BeautifulSoup(cat_resp.content, "html.parser")
                breadcrumb = cat_soup.find("ul", class_="breadcrumb")
                if breadcrumb:
                    lis = breadcrumb.find_all("li")
                    if len(lis) >= 3:
                        category_name = lis[2].text.strip()
                        
            scraped_data.append({
                "title": title,
                "price_raw": price_text,
                "rating_raw": rating_str,
                "availability_raw": availability_text,
                "category": category_name
            })
            if len(scraped_data) >= min_books:
                break
                
        next_button = soup.find("li", class_="next")
        if next_button and next_button.a:
            next_page = next_button.a["href"]
            if not next_page.startswith("catalogue/"):
                next_page = "catalogue/" + next_page
            page_url = urllib.parse.urljoin(BASE_URL, next_page)
        else:
            page_url = None

    return scraped_data

def clean_data(raw_data):
    cleaned = []
    for item in raw_data:
        # 1. Price conversion
        price_match = re.search(r"[\d\.]+", item["price_raw"])
        price_gbp = float(price_match.group(0)) if price_match else None
        
        # 2. Rating conversion
        rating = RATING_MAP.get(item["rating_raw"].lower(), None)
        
        # 3. Availability parsing
        in_stock = 1 if "in stock" in item["availability_raw"].lower() else 0
        
        # 4. Baseline Currency conversion (1 GBP = 105.50 INR)
        price_inr = round(price_gbp * FIXED_GBP_TO_INR, 2) if price_gbp is not None else None
        
        cleaned.append({
            "title": item["title"],
            "price_gbp": price_gbp,
            "price_inr": price_inr,
            "rating": rating,
            "in_stock": in_stock,
            "category": item["category"]
        })
        
    df = pd.DataFrame(cleaned)
    # Median Imputation for Numeric fields if missing
    if df["price_gbp"].isnull().any():
        median_val = df["price_gbp"].median()
        df["price_gbp"].fillna(median_val, inplace=True)
        df["price_inr"].fillna(round(median_val * FIXED_GBP_TO_INR, 2), inplace=True)
        
    if df["rating"].isnull().any():
        df["rating"].fillna(df["rating"].median(), inplace=True)
        
    df["rating"] = df["rating"].astype(int)
    return df

def setup_and_load_db(df):
    if os.path.exists(DB_PATH):
        os.remove(DB_PATH)
        
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("PRAGMA foreign_keys = ON;")
    
    cursor.execute("""
        CREATE TABLE categories (
            category_id INTEGER PRIMARY KEY AUTOINCREMENT,
            category_name TEXT UNIQUE NOT NULL
        );
    """)
    
    cursor.execute("""
        CREATE TABLE books (
            book_id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            price_gbp REAL NOT NULL,
            price_inr REAL NOT NULL,
            rating INTEGER NOT NULL,
            in_stock INTEGER NOT NULL,
            category_id INTEGER,
            FOREIGN KEY (category_id) REFERENCES categories (category_id)
        );
    """)
    
    categories = df["category"].unique()
    cat_map = {}
    for cat in categories:
        cursor.execute("INSERT INTO categories (category_name) VALUES (?);", (cat,))
        cat_map[cat] = cursor.lastrowid
        
    for _, row in df.iterrows():
        cursor.execute("""
            INSERT INTO books (title, price_gbp, price_inr, rating, in_stock, category_id)
            VALUES (?, ?, ?, ?, ?, ?);
        """, (row["title"], row["price_gbp"], row["price_inr"], row["rating"], row["in_stock"], cat_map[row["category"]]))
        
    conn.commit()
    return conn

def run_queries_and_verify(conn):
    print("=== Executing 5 SQL Queries ===")
    
    # Query 1: SELECT / WHERE
    q1 = "SELECT title, price_gbp FROM books WHERE price_gbp > 50.0;"
    df_q1 = pd.read_sql_query(q1, conn)
    print("\n1. Books priced > £50:\n", df_q1.head())
    
    # Query 2: ORDER BY / LIMIT
    q2 = "SELECT title, price_inr FROM books ORDER BY price_inr DESC LIMIT 5;"
    df_q2 = pd.read_sql_query(q2, conn)
    print("\n2. Top 5 Most Expensive Books (INR):\n", df_q2)
    
    # Query 3: DISTINCT
    q3 = "SELECT DISTINCT rating FROM books ORDER BY rating ASC;"
    df_q3 = pd.read_sql_query(q3, conn)
    print("\n3. Distinct Star Ratings:\n", df_q3)
    
    # Query 4: BETWEEN / IN
    q4 = "SELECT title, rating, price_gbp FROM books WHERE rating IN (4, 5) AND price_gbp BETWEEN 20 AND 40;"
    df_q4 = pd.read_sql_query(q4, conn)
    print("\n4. High rated books between £20 and £40:\n", df_q4.head())
    
    # Query 5: JOIN
    q5 = """
        SELECT b.title, c.category_name, b.rating, b.price_gbp
        FROM books b
        JOIN categories c ON b.category_id = c.category_id
        WHERE b.rating = 5
        ORDER BY b.price_gbp DESC
        LIMIT 10;
    """
    df_sql_join = pd.read_sql_query(q5, conn)
    print("\n5. SQL JOIN - Top 10 5-Star Books by Category:\n", df_sql_join)
    
    # Pandas MERGE Parity Reproduction
    df_books = pd.read_sql_query("SELECT * FROM books;", conn)
    df_categories = pd.read_sql_query("SELECT * FROM categories;", conn)
    
    merged = pd.merge(df_books, df_categories, on="category_id")
    merged_filtered = merged[merged["rating"] == 5].sort_values(by="price_gbp", ascending=False).head(10)
    df_pandas_join = merged_filtered[["title", "category_name", "rating", "price_gbp"]].reset_index(drop=True)
    
    print("\n=== Pandas merge() Result Verification ===")
    print(df_pandas_join)
    
    # Asserting equivalence
    pd.testing.assert_frame_equal(
        df_sql_join.reset_index(drop=True), 
        df_pandas_join, 
        check_dtype=False
    )
    print("\nSUCCESS: SQL JOIN and Pandas merge() outputs are identical!")

if __name__ == "__main__":
    raw_data = scrape_catalog(min_books=60)
    df_cleaned = clean_data(raw_data)
    conn = setup_and_load_db(df_cleaned)
    run_queries_and_verify(conn)
    conn.close()
